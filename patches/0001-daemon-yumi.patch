+/// yumi (16.10): the lyrics as in music players — just the current line, centred, the next one cross-fading in
+/// (0.3 s). Replaces the karaoke ribbon on the bar's "now playing"; the full-screen visualiser keeps draw_lyrics.
+fn draw_lyric_line(m: &Model, p: &Painter, pal: &Palette, x: f64, w: f64, cy: f64, now: Instant) {
+    let c = p.c;
+    let lines = m.lyrics();
+    let Some((pos, _len)) = m.position(now) else { return };
+    let pos = pos + m.lyrics_offset();
+    if lines.is_empty() || w <= 0.0 {
+        return;
+    }
+    let cur = lines.iter().rposition(|(t, _)| *t <= pos);
+    let line_of = |i: Option<usize>| -> String {
+        match i {
+            Some(i) => {
+                let l = lines[i].1.trim();
+                if l.is_empty() { "♪".to_string() } else { l.to_string() }
+            }
+            None => "♪".to_string(),
+        }
+    };
+    let since = cur.map(|i| pos - lines[i].0).unwrap_or(f64::MAX);
+    let k = (since / 0.3).clamp(0.0, 1.0);
+    let k = k * k * (3.0 - 2.0 * k);
+    c.save().unwrap();
+    c.rectangle(x, MARGIN_Y, w, m.h - 2.0 * MARGIN_Y);
+    c.clip();
+    let draw = |text: &str, alpha: f64, dy: f64| {
+        if alpha <= 0.0 {
+            return;
+        }
+        // shrink a long line down to 18 px before cutting it with an ellipsis
+        let mut px = LABEL_PX;
+        while px > 18.0 && p.text_width(text, px, false) > w - 8.0 {
+            px -= 1.0;
+        }
+        c.push_group();
+        pal.fg.set(c);
+        p.text(text, px, false, x + w / 2.0, cy + dy, Some(w - 8.0));
+        c.pop_group_to_source().unwrap();
+        c.paint_with_alpha(alpha).unwrap();
+    };
+    if k < 1.0 {
+        // the previous line slides up and fades, the new one rises in
+        let prev = cur.and_then(|i| i.checked_sub(1));
+        if cur.is_some() {
+            draw(&line_of(prev), (1.0 - k) * (1.0 - k), -26.0 * k);
+        }
+        draw(&line_of(cur), k * k, 26.0 * (1.0 - k));
+    } else {
+        draw(&line_of(cur), 1.0, 0.0);
+    }
+    c.restore().unwrap();
+}
