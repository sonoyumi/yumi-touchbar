+        if let Some(h) = &self.home_override {
+            if self.layout.layers.contains_key(h) && !ring.contains(h) {
+                ring.insert(0, h.clone());
+            }
+        }
+        ring
+    }
+
+    /// Соседний слой по кольцу: dir = 1 — следующий (свайп влево), -1 — предыдущий.
+    pub fn swipe_neighbor(&self, dir: i32) -> Option<String> {
+        let ring = self.swipe_ring();
+        let p = ring.iter().position(|l| *l == self.layer)? as i32;
+        Some(ring[(p + dir).rem_euclid(ring.len() as i32) as usize].clone())
+    }
+
+    /// Можно ли сейчас начать свайп: обычный слой из кольца, без overlay и Fn.
+    fn swipe_allowed(&self) -> bool {
+        !self.fn_held
+            && !self.overlay_open()
+            && self.sync_open.is_none()
+            && self.swipe_ring().contains(&self.layer)
+    }
+
+    /// yumi (19.10): второй палец может начать свайп двумя пальцами: слой из кольца, без Fn/сдвига текста,
+    /// погода и визуализатор закрыты; открытый ползунок — только если его открыл этот же первый палец.
+    fn two_allowed(&self, other: Option<&Grab>) -> bool {
+        !self.fn_held
+            && self.sync_open.is_none()
+            && self.weather.is_none()
+            && self.viz.is_none()
+            && self.swipe_ring().contains(&self.layer)
+            && (self.slider.is_none() || matches!(other, Some(Grab::SliderDrag { .. })))
+    }
+
+    /// yumi (19.10): коснулся второй палец — отменить то, что начал первый (клавишу отпустить, ползунок
+    /// закрыть и вернуть значение), и вести свайп слоёв по среднему двух пальцев. None — не наш случай.
+    fn try_two_finger(&mut self, slot: u32, x: f64) -> Option<Vec<Effect>> {
+        if self.two.is_some() || self.grabs.len() != 1 {
+            return None;
+        }
+        let other = *self.grabs.keys().next()?;
+        if other == slot || !self.two_allowed(self.grabs.get(&other)) {
+            return None;
+        }
+        let mut fx = vec![];
+        let deferred = self.deferred.remove(&other).is_some();
+        self.swipe_from.remove(&other);
+        match self.grabs.remove(&other) {
+            Some(Grab::Press { hit, keys, inside, .. }) => {
+                self.pressed.remove(&hit);
+                if inside && !deferred && !keys.is_empty() {
+                    fx.push(Effect::KeyUp(keys));
+                }
+            }
+            Some(Grab::SliderDrag { start_v, moved, .. }) => {
+                if moved {
+                    if let Some(key) = self.slider.as_ref().map(|s| s.key.clone()) {
+                        fx.push(self.set_value(&key, start_v));
+                    }
+                }
+                self.slider = None;
+            }
+            _ => {}
+        }
+        let ox = self.last_x.get(&other).copied().unwrap_or(x);
+        self.two = Some(TwoFinger { start: (ox + x) / 2.0, xs: HashMap::from([(other, ox), (slot, x)]) });
+        self.grabs.insert(other, Grab::TwoFinger);
+        self.grabs.insert(slot, Grab::TwoFinger);
+        self.swipe_anim = None;
+        self.swipe = Some(0.0);
+        Some(fx)
+    }
+
+    /// Палец прошёл порог длинного свайпа.
+    pub fn swipe_passed(&self, dx: f64) -> bool {
+        dx.abs() >= self.layout.settings.swipe_min * self.w
+    }
+
+    /// Подпись слоя: из `layer_names`, иначе ключ.
+    pub fn layer_title(&self, name: &str) -> String {
+        self.layout.settings.layer_names.get(name).cloned().unwrap_or_else(|| name.to_string())
+    }
+
+    /// Что рисовать в движении: (слой, его сдвиг, соседний слой у края).
+    pub fn swipe_view(&self, now: Instant) -> Option<(String, f64, Option<String>)> {
+        if let Some(dx) = self.swipe {
+            let off = dx * SWIPE_FOLLOW;
+            let other = if off == 0.0 { None } else { self.swipe_neighbor(if off < 0.0 { 1 } else { -1 }) };
+            return Some((self.layer.clone(), off, other));
+        }
+        let a = self.swipe_anim.as_ref()?;
+        let t = ((now - a.start).as_secs_f64() / a.dur.as_secs_f64().max(0.001)).min(1.0);
+        let e = 1.0 - (1.0 - t).powi(3);
+        Some((a.base.clone(), a.from + (a.to - a.from) * e, Some(a.other.clone())))
+    }
+
+    /// Индикатор: (подпись, номер в кольце, длина кольца) — во время свайпа и ~0,8 с после.
+    pub fn layer_badge(&self, now: Instant) -> Option<(String, usize, usize)> {
+        if self.swipe.is_none() && !self.badge_until.is_some_and(|t| now < t) {
+            return None;
+        }
+        // Во время свайпа — слой, который будет после отпускания.
+        let name = match self.swipe {
+            Some(dx) if self.swipe_passed(dx) => self.swipe_neighbor(if dx < 0.0 { 1 } else { -1 })?,
+            _ => self.layer.clone(),
+        };
+        let ring = self.swipe_ring();
+        let i = ring.iter().position(|l| *l == name)?;
+        Some((self.layer_title(&name), i, ring.len()))
+    }
+
+    /// Отпустили палец после свайпа: переключиться по кольцу или вернуть слой на место.
+    fn finish_swipe(&mut self, now: Instant) -> Vec<Effect> {
+        let mut fx = vec![];
+        let dx = self.swipe.take().unwrap_or(0.0);
+        let off = dx * SWIPE_FOLLOW;
+        let dir = if dx < 0.0 { 1 } else { -1 };
+        let dur = Duration::from_millis(self.layout.settings.swipe_anim_ms);
+        match self.swipe_neighbor(dir) {
+            Some(next) if self.swipe_passed(dx) => {
+                let from_layer = self.layer.clone();
+                fx.extend(self.switch_layer(&next));
+                self.weather = None;
+                fx.push(Effect::Send(Outgoing::Layer { name: next.clone() }));
+                self.badge_until = Some(now + BADGE_FOR);
+                self.swipe_anim = Some(SwipeAnim {
+                    base: from_layer,
+                    other: next,
+                    from: off,
+                    to: -(dir as f64) * (self.w + SWIPE_GAP),
+                    start: now,
+                    dur,
+                });
+            }
+            Some(other) if off != 0.0 => {
+                self.swipe_anim = Some(SwipeAnim { base: self.layer.clone(), other, from: off, to: 0.0, start: now, dur });
+            }
+            _ => {}
+        }
+        fx
+    }
+
+    /// Отложенные KeyDown, которым пора (палец стоит на кнопке дольше KEY_DEFER).
+    pub fn due_keys(&mut self, now: Instant) -> Vec<Effect> {
+        let due: Vec<u32> = self.deferred.iter().filter(|(_, t)| **t <= now).map(|(s, _)| *s).collect();
+        let mut fx = vec![];
+        for slot in due {
+            self.deferred.remove(&slot);
+            if let Some(Grab::Press { keys, inside: true, .. }) = self.grabs.get(&slot) {
+                if !keys.is_empty() {
+                    fx.push(Effect::KeyDown(keys.clone()));
+                    // Клавиша уже зажата — из этого касания свайп больше не начнётся.
+                    self.swipe_from.remove(&slot);
+                }
+            }
+        }
+        fx
+    }
