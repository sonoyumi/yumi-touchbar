+
+/// PNG по пути, читается один раз (печать Touch ID, image у кнопок). Службе закрыт ~ — путь из /usr/local/share.
+fn png(path: &str) -> Option<cairo::ImageSurface> {
+    if path.is_empty() {
+        return None;
+    }
+    PNGS.with(|cell| {
+        cell.borrow_mut()
+            .entry(path.to_string())
+            .or_insert_with(|| {
+                let img = fs::File::open(path).ok().and_then(|mut f| cairo::ImageSurface::create_from_png(&mut f).ok());
+                if img.is_none() {
+                    eprintln!("png: не удалось прочитать {path}");
+                }
+                img
+            })
+            .clone()
+    })
+}
