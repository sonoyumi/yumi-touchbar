+
+    fn ups(fx: &[Effect]) -> usize {
+        fx.iter().filter(|e| matches!(e, Effect::KeyUp(_))).count()
+    }
+
+    fn ran(fx: &[Effect]) -> bool {
+        fx.iter().any(|e| matches!(e, Effect::Send(Outgoing::Run { .. })))
+    }
+
+    fn sent_layer(fx: &[Effect]) -> Option<String> {
+        fx.iter().find_map(|e| match e {
+            Effect::Send(Outgoing::Layer { name }) => Some(name.clone()),
+            _ => None,
+        })
+    }
+
+    /// Касание в x0, палец до x1, отпустить — все эффекты подряд.
+    fn drag(m: &mut Model, x0: f64, x1: f64) -> Vec<Effect> {
+        let mut fx = m.touch_down(0, x0);
+        let steps = 8;
+        for i in 1..=steps {
+            fx.extend(m.touch_motion(0, x0 + (x1 - x0) * i as f64 / steps as f64));
+        }
+        fx.extend(m.touch_up(0));
+        fx
+    }
+
+    #[test]
+    fn tap_on_buttons_works() {
+        let mut m = model();
+        // Кнопка-клавиша: KeyDown отложен, при коротком тапе — нажать и отпустить.
+        let x = mid(&m, 0);
+        let fx = m.touch_down(0, x);
+        assert_eq!(downs(&fx), 0);
+        let fx = m.touch_up(0);
+        assert_eq!((downs(&fx), ups(&fx)), (1, 1));
+        // Кнопка-команда: срабатывает при отпускании.
+        let x = mid(&m, 1);
+        m.touch_down(0, x);
+        let fx = m.touch_up(0);
+        assert!(ran(&fx));
+        assert_eq!(m.layer, "control");
+    }
+
+    #[test]
+    fn held_key_goes_down_after_defer() {
+        let mut m = model();
+        let x = mid(&m, 0);
+        m.touch_down(0, x);
+        let fx = m.due_keys(Instant::now() + KEY_DEFER);
+        assert_eq!(downs(&fx), 1);
+        let fx = m.touch_up(0);
+        assert_eq!((downs(&fx), ups(&fx)), (0, 1));
+    }
+
+    #[test]
+    fn short_swipe_springs_back_and_presses_nothing() {
+        let mut m = model();
+        for n in [0, 1] {
+            let x = mid(&m, n);
+            let fx = drag(&mut m, x, x - 150.0);
+            assert_eq!((downs(&fx), ups(&fx)), (0, 0), "кнопка {n}");
+            assert!(!ran(&fx), "кнопка {n}");
+            assert_eq!(sent_layer(&fx), None);
+            assert_eq!(m.layer, "control");
+            let a = m.swipe_anim.as_ref().expect("анимация возврата");
+            assert_eq!(a.to, 0.0);
+            assert!(m.swipe.is_none());
+        }
+    }
+
+    #[test]
+    fn long_swipe_walks_the_ring() {
+        let mut m = model();
+        // Влево = следующий.
+        let fx = drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "work");
+        assert_eq!(sent_layer(&fx).as_deref(), Some("work"));
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "tools");
+        // По кругу: после последнего — первый.
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "control");
+        // Вправо = предыдущий, тоже по кругу.
+        drag(&mut m, 200.0, 1000.0);
+        assert_eq!(m.layer, "tools");
+        assert!(m.badge_until.is_some());
+        // Со стартом на кнопке-клавише — ничего не нажато.
+        let mut m = model();
+        let x = mid(&m, 0);
+        let fx = drag(&mut m, x, x - 800.0);
+        assert_eq!(m.layer, "work");
+        assert_eq!((downs(&fx), ups(&fx)), (0, 0));
+    }
+
+    #[test]
+    fn app_layer_takes_home_slot() {
+        let mut m = model();
+        m.agent_layer("telegram");
+        assert_eq!(m.layer, "telegram");
+        assert_eq!(m.swipe_ring(), vec!["telegram", "control", "work", "tools"]);
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "control");
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "work");
+        // Назад: work → control → слой приложения.
+        drag(&mut m, 200.0, 1000.0);
+        assert_eq!(m.layer, "control");
+        drag(&mut m, 200.0, 1000.0);
+        assert_eq!(m.layer, "telegram");
+        // default снимает подмену.
+        m.agent_layer("control");
+        assert!(m.home_override.is_none());
+        assert_eq!(m.swipe_ring(), vec!["control", "work", "tools"]);
+        // Слой из кольца — тоже.
+        m.agent_layer("telegram");
+        m.agent_layer("tools");
+        assert!(m.home_override.is_none());
+    }
+
+    #[test]
+    fn slider_and_weather_swipe_untouched() {
+        let mut m = model();
+        // Ползунок: тянем от кнопки — меняется значение, слой не едет.
+        let x = mid(&m, 2);
+        let mut fx = m.touch_down(0, x);
+        fx.extend(m.touch_motion(0, x + 300.0));
+        assert!(m.swipe.is_none());
+        assert!(fx.iter().any(|e| matches!(e, Effect::Send(Outgoing::Set { .. }))));
+        m.touch_up(0);
+        assert_eq!(m.layer, "control");
+        m.slider = None;
+        // Погода: свайп по прогнозу листает часы/дни.
+        let x = mid(&m, 3);
+        m.touch_down(0, x);
+        m.touch_up(0);
+        assert!(m.weather.is_some());
+        let (_, px, pw) = m.overlay_parts().into_iter().find(|(p, _, _)| *p == Part::WHours).unwrap();
+        drag(&mut m, px + pw / 2.0, px + pw / 2.0 + 200.0);
+        assert!(m.weather_days);
+        assert!(m.swipe.is_none() && m.swipe_anim.is_none());
+        assert_eq!(m.layer, "control");
+    }
+
+    #[test]
+    fn second_finger_ignored_during_swipe() {
+        let mut m = model();
+        m.touch_down(0, 1800.0);
+        m.touch_motion(0, 1600.0);
+        assert!(m.swipe.is_some());
+        let x = mid(&m, 1);
+        m.touch_down(1, x);
+        let fx = m.touch_up(1);
+        assert!(!ran(&fx));
+        m.touch_motion(0, 1000.0);
+        m.touch_up(0);
+        assert_eq!(m.layer, "work");
+    }
+
+    #[test]
+    fn no_ring_means_old_behaviour() {
+        let mut m = model();
+        m.layout.settings.swipe_layers.clear();
+        let x = mid(&m, 0);
+        let fx = m.touch_down(0, x);
+        assert_eq!(downs(&fx), 1, "без кольца клавиша нажимается сразу, как раньше");
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "control");
+    }
+
+    /// Два пальца: оба ставим, ведём вместе на dx, отпускаем первый.
+    fn two_drag(m: &mut Model, a: f64, b: f64, dx: f64) -> Vec<Effect> {
+        let mut fx = m.touch_down(0, a);
+        fx.extend(m.touch_down(1, b));
+        let steps = 8;
+        for i in 1..=steps {
+            let d = dx * i as f64 / steps as f64;
+            fx.extend(m.touch_motion(0, a + d));
+            fx.extend(m.touch_motion(1, b + d));
+        }
+        fx.extend(m.touch_up(0));
+        fx.extend(m.touch_up(1));
+        fx
+    }
+
+    #[test]
+    fn two_finger_swipe_from_key_buttons() {
+        let mut m = model();
+        let (a, b) = (mid(&m, 0), mid(&m, 1));
+        let fx = two_drag(&mut m, a, b, -800.0);
+        assert_eq!(downs(&fx), 0, "клавиша первого пальца не должна нажаться");
+        assert!(!ran(&fx), "команда второй кнопки не должна выполниться");
+        assert_eq!(m.layer, "work");
+        assert_eq!(sent_layer(&fx).as_deref(), Some("work"));
+        // и назад вправо
+        let fx = two_drag(&mut m, 300.0, 500.0, 800.0);
+        assert_eq!(m.layer, "control");
+        assert_eq!(downs(&fx), 0);
+    }
+
+    #[test]
+    fn two_finger_swipe_from_slider_closes_it_and_restores_value() {
+        let mut m = model();
+        let s = mid(&m, 2);
+        let mut fx = m.touch_down(0, s);
+        assert!(m.slider.is_some(), "касание ползунка открывает его");
+        fx.extend(m.touch_motion(0, s + 40.0));         // палец уже чуть подвинул значение
+        fx.extend(m.touch_down(1, s + 300.0));          // второй палец
+        assert!(m.slider.is_none(), "второй палец закрывает ползунок");
+        let restored = fx.iter().rev().find_map(|e| match e {
+            Effect::Send(Outgoing::Set { k, v }) if k == "volume" => Some(*v),
+            _ => None,
+        });
+        assert_eq!(restored, Some(0.0), "значение вернулось к исходному");
+        for i in 1..=8 {
+            let d = -800.0 * i as f64 / 8.0;
+            m.touch_motion(0, s + 40.0 + d);
+            m.touch_motion(1, s + 300.0 + d);
+        }
+        m.touch_up(1);
+        m.touch_up(0);
+        assert_eq!(m.layer, "work");
+    }
+
+    #[test]
+    fn short_two_finger_swipe_springs_back() {
+        let mut m = model();
+        let (a, b) = (mid(&m, 0), mid(&m, 1));
+        let fx = two_drag(&mut m, a, b, -120.0);
+        assert_eq!(m.layer, "control");
+        assert_eq!((downs(&fx), ran(&fx)), (0, false));
+        assert!(m.swipe.is_none() && m.two.is_none());
+    }
+
+    #[test]
+    fn one_finger_tap_still_presses() {
+        let mut m = model();
+        let x = mid(&m, 1);
+        m.touch_down(0, x);
+        let fx = m.touch_up(0);
+        assert!(ran(&fx));
+        assert!(m.two.is_none());
+    }
+
+    /// Случай с полосы (19.10): в фокусе окно со своим слоем, кнопкой «на главный» ушли на control —
+    /// свайп с главного должен работать (раньше слой приложения вытеснял control из кольца).
+    #[test]
+    fn swipe_from_main_while_app_focused() {
+        let mut m = model();
+        m.agent_layer("telegram");
+        m.switch_layer("control");
+        assert!(m.swipe_allowed());
+        drag(&mut m, 1800.0, 1000.0);
+        assert_eq!(m.layer, "work");
+    }
+}
