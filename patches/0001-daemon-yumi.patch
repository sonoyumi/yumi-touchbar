+fn lock_shake(d: f64) -> f64 {
+    if !(0.0..0.45).contains(&d) {
+        return 0.0;
+    }
+    let k = [0.0, -10.0, 10.0, -10.0, 10.0, 0.0];
+    let i = ((d / 0.09) as usize).min(4);
+    let f = d / 0.09 - i as f64;
+    k[i] + (k[i + 1] - k[i]) * f
