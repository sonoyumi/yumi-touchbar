+/// Текст своим шрифтом; x — левый край (или центр при center), cy — середина строки. Возвращает ширину.
+fn seal_text(c: &Context, s: &str, family: &str, weight: pango::Weight, px: f64, x: f64, cy: f64, center: bool) -> f64 {
+    let l = pangocairo::functions::create_layout(c);
+    let mut fd = pango::FontDescription::new();
+    fd.set_family(family);
+    fd.set_weight(weight);
+    fd.set_absolute_size(px * pango::SCALE as f64);
+    l.set_font_description(Some(&fd));
+    l.set_text(s);
+    let (_, lg) = l.pixel_extents();
+    let (w, h) = (lg.width() as f64, lg.height() as f64);
+    c.move_to((if center { x - w / 2.0 } else { x }).round(), (cy - h / 2.0).round());
+    pangocairo::functions::show_layout(c, &l);
+    w
+}
